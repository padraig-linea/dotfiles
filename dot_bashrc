# Added by Patrick
# Bash alias to run .ps1 Powershell scripts from bash
# NOTE: Uses Powershell 7 - not the native Windows install (Powershell 5.1)
psrun() {
  if [ $# -eq 0 ]; then
    echo "usage: psrun <script.ps1> [args...]" >&2
    return 2
  fi

  local script="$1"; shift
  if command -v cygpath >/dev/null 2>&1; then
    script="$(cygpath -w "$script")"
  elif command -v wslpath >/dev/null 2>&1; then
    script="$(wslpath -w "$script")"
  fi

  MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' \
    pwsh.exe -NoProfile -ExecutionPolicy Bypass -File "$script" "$@"
}


